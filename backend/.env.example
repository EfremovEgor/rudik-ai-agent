# --- Языковая модель: self-hosted Qwen на vLLM (OpenAI-совместимый API) ---
RUDIK_LLM_BASE_URL=http://10.129.15.215:8000/v1
RUDIK_MODEL=qwen38-flash-next
# vLLM ключ не проверяет, но клиент требует непустое значение
RUDIK_LLM_API_KEY=EMPTY
RUDIK_MAX_TOKENS=1200
RUDIK_TEMPERATURE=0.3
RUDIK_LLM_TIMEOUT=120
# Больше не используется (модель self-hosted):
# ANTHROPIC_API_KEY=sk-ant-...

# --- Сервер ---
RUDIK_HOST=127.0.0.1
RUDIK_PORT=8000
RUDIK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Скрапер ---
RUDIK_SITE_BASE=https://academy.rudn.ru
RUDIK_CRAWL_DELAY=0.4
RUDIK_CRAWL_MAX_PAGES=400
# Ходить за страницами через системный прокси (по умолчанию нет: рвёт соединение)
RUDIK_SCRAPER_TRUST_ENV=false

# --- RAG ---
# hash | fastembed  (fastembed требует `uv sync --extra rag`)
RUDIK_EMBEDDINGS=fastembed
# Качество повыше, но 2.2 ГБ: intfloat/multilingual-e5-large
RUDIK_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RUDIK_TOP_K=6

# --- Голос ---
# Распознавание: GigaAM v3 (E2E RNN-T) в ONNX
RUDIK_ASR_MODEL=gigaam-v3-e2e-rnnt
# int8 быстрее и легче; пусто — исходная точность
RUDIK_ASR_QUANTIZATION=int8
# Маленькая модель, которая всё время слушает поток и ловит обращение
RUDIK_HOTWORD_MODEL=vosk-model-small-ru-0.22
RUDIK_STREAM_PREROLL_MS=2000
RUDIK_STREAM_MAX_UTTERANCE_S=15
# edge | none
RUDIK_TTS_BACKEND=edge
RUDIK_TTS_VOICE=ru-RU-DmitryNeural
RUDIK_WAKE_WORD=рудик
# Ловить обращение отдельным распознавателем, которому разрешено только имя
RUDIK_HOTWORD_GRAMMAR=true
# Порог уверенности для перехвата ответа (настоящее обращение даёт 1.0)
RUDIK_HOTWORD_CONFIDENCE=0.9
# Сколько ответ защищён от перехвата после начала, мс
RUDIK_INTERRUPT_GUARD_MS=1500
# Пауза, после которой диалог начинается заново: у экрана уже другой человек
RUDIK_DIALOG_TTL_S=180
